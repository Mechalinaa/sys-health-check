# https://editorconfig.org - read by PyCharm, VS Code and most editors
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false
